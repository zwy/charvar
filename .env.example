# ComfyUI（示例，按你的 ComfyUI 地址自行替换）
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_TIMEOUT=180
COMFYUI_WORKFLOWS_DIR=./data/workflows
CHARVAR_DATA_DIR=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-******
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# OpenRouter 在线生图（可选）：API Key 不配则回退 LLM_API_KEY
OP_IMAGE_API_KEY=
OP_IMAGE_TIMEOUT=300
# 文生图（不带参考图时的通路）
OP_IMAGE_T2I_MODEL=meta/muse-image
# OP_IMAGE_T2I_RESOLUTION=   # 模型声明枚举时才生效：512 | 1K | 1.5K | 2K | 4K …（动态，以 api-response.json 为准）
# OP_IMAGE_T2I_QUALITY=     # auto | low | medium | high …（动态；auto = 不发送该参数）
# 图片编辑 / 参考生图（带参考图时的通路）
# OP_IMAGE_I2I_MODEL=       # 不设则回退 OP_IMAGE_T2I_MODEL → OP_IMAGE_MODEL → 默认
# OP_IMAGE_I2I_RESOLUTION=
# OP_IMAGE_I2I_QUALITY=
# 注：CHARVAR_WEB_PORT（服务端口，默认 8710）只被 python -m web.app 前台模式读到这里；
# scripts/start.sh / stop.sh 只认 shell 环境变量（示例：CHARVAR_WEB_PORT=8799 ./scripts/start.sh）